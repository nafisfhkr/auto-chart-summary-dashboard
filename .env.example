APP_ENV=development

DATABASE_URL=

METABASE_SITE_URL=http://localhost:3000
METABASE_EMBED_SECRET_KEY=
METABASE_API_KEY=
METABASE_USERNAME=
METABASE_PASSWORD=


# ==========================================
# LLM Configuration (Swappable Providers)
# ==========================================
# Pilihan LLM_PROVIDER: 9router | ollama | groq
LLM_PROVIDER=9router
LLM_TIMEOUT_SECONDS=60

# --- Opsi 1: 9Router (Local Proxy / Frontier Models) ---
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
LLM_MODEL=oc/muse-spark-1.3-contributor-free

# --- Opsi 2: Ollama (Jalur A - Local Open-Source) ---
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3:8b

# --- Opsi 3: Groq (Jalur B1 - Ultra-Fast Cloud API) ---
# LLM_PROVIDER=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_groq_api_key_here
# LLM_MODEL=llama-3.1-70b-versatile

AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_WEBSERVER_SECRET_KEY=

SUMMARY_MAX_SENTENCES=3
SUMMARY_LANGUAGE=id
